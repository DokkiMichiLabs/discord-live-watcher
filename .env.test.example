# Copy to .env.test. Replace placeholders using independently provisioned TEST resources only.
# Load with scripts/integration-local.js; never copy a production .env or database.
DISCORD_TOKEN=<TEST_BOT_TOKEN>
DISCORD_CLIENT_ID=<TEST_DISCORD_APPLICATION_ID>
DISCORD_GUILD_ID=<TEST_GUILD_ID>
TEST_DISCORD_CHANNEL_ID=<TEST_CHANNEL_ID>
TEST_DISCORD_USER_ID=<TEST_USER_ID>
TEST_TWITCH_USERNAME=<ONE_TEST_TWITCH_LOGIN>
TWITCH_CLIENT_ID=<TEST_TWITCH_APPLICATION_ID>
TWITCH_CLIENT_SECRET=<TEST_TWITCH_APPLICATION_SECRET>
DATABASE_URL=postgresql://<TEST_DB_USER>:<TEST_DB_PASSWORD>@127.0.0.1:5433/discord_live_watcher_integration?schema=public

# Required isolation settings: deliberately no role mention, TikTok, Euler, or listener.
DISCORD_NOTIFICATION_ROLE_ID=
TIKTOK_WATCHER_ENABLED=false
WEBHOOK_SERVER_ENABLED=false
EULER_ALERTS_ENABLED=false
EULER_API_KEY=
EULER_ACCOUNT_ID=
EULER_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
TWITCH_WATCH_INTERVAL_MS=60000
TWITCH_THUMBNAIL_REFRESH_MS=300000
NODE_ENV=production
